# ========================================================
# CẤU HÌNH ĐỒNG BỘ ONLINE (FIREBASE & CLOUDINARY) - MEN'S DAY 19/11
# ========================================================
# Lưu ý: Nếu chưa cấu hình các biến bên dưới, trang web vẫn hoạt động
# bình thường và tự động lưu Video/Ảnh vào IndexedDB của trình duyệt!
# ========================================================

# 1. Cloudinary (Lưu trữ Video & Ảnh miễn phí 25GB/tháng)
# Đăng ký miễn phí tại https://cloudinary.com -> Tạo 1 Unsigned Upload Preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# 2. Firebase Realtime Database (Đồng bộ Bảng vàng trực tuyến miễn phí)
# Tạo dự án tại https://console.firebase.google.com -> Tạo Realtime Database (test mode)
VITE_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
